# SMJ Retail ERP production environment. Copy to .env and fill REAL values there.
# NEVER commit the real .env. Placeholders only in this file.

# Immutable image tag pushed to your registry (see apps.pinning.md)
IMAGE=your-registry/smj-erp:v1.0.0-rc3

# The production site/domain (must match the site created inside the sites volume)
SITE_NAME=erp.example.com

# --- Secrets (fill in .env, keep out of git) ---
DB_ROOT_PASSWORD=__CHANGE_ME__
# Site Administrator password is set at site-creation time (see scripts/deploy.sh),
# not stored here.
# ADMIN_PASSWORD is passed only interactively during first site creation.

# --- Backups (destination configured in scripts/backup.sh) ---
BACKUP_DESTINATION=__offsite-encrypted-target__
